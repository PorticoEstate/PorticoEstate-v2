{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ qualification_id ? lang('edit qualification') : lang('add qualification') }}{% endblock %}

{% block styles %}<style>{{ source('@views/job/hrm_job_task_edit.twig')|split('<style>')[1]|split('</style>')[0]|replace({'hrm-task-form': 'hrm-qualification-form'})|raw }}</style>{% endblock %}

{% block content %}
	<div class="hrm-qualification-form"><div class="hrm-qualification-form__header"><h1>{{ qualification_id ? lang('edit qualification') : lang('add qualification') }}: {{ job.name|default('') }}</h1><div><a href="{{ qualification_type_url|e }}">{{ lang('qualification') }}</a> | <a href="{{ list_url|e }}">{{ lang('Back to the list') }}</a></div></div>
	{% if errors %}<div class="hrm-qualification-form__notice hrm-qualification-form__notice--error">{% for error in errors %}<div>{{ error }}</div>{% endfor %}</div>{% endif %}{% if messages %}<div class="hrm-qualification-form__notice hrm-qualification-form__notice--message">{% for message in messages %}<div>{{ message }}</div>{% endfor %}</div>{% endif %}
	<form method="post" action="{{ form_action|e }}"><div class="hrm-qualification-form__grid">{% if qualification_id %}<div class="hrm-qualification-form__field"><label>{{ lang('qualification ID') }}</label><div>{{ qualification_id }}</div></div>{% endif %}{% if values.entry_date %}<div class="hrm-qualification-form__field"><label>{{ lang('Entry date') }}</label><div>{{ values.entry_date }}</div></div>{% endif %}
	<div class="hrm-qualification-form__field"><label for="hrm-qualification-category">{{ lang('category') }}</label><select id="hrm-qualification-category" class="hrm-qualification-form__input" name="values[cat_id]" required><option value="0">{{ lang('no category') }}</option>{% for category in cat_list %}<option value="{{ category.id }}" {% if category.selected %}selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></div>
	<div class="hrm-qualification-form__field"><label for="hrm-qualification-type">{{ lang('name') }}</label><select id="hrm-qualification-type" class="hrm-qualification-form__input" name="values[quali_type_id]" required><option value="0">{{ lang('select') }}</option>{% for type in qualification_types %}<option value="{{ type.id }}" {% if type.selected %}selected{% endif %}>{{ type.name }}</option>{% endfor %}</select></div>
	<div class="hrm-qualification-form__field"><label for="hrm-qualification-skill">{{ lang('Skill level') }}</label><select id="hrm-qualification-skill" class="hrm-qualification-form__input" name="values[skill_id]"><option value="0">{{ lang('select a level') }}</option>{% for skill in skill_list %}<option value="{{ skill.id }}" {% if skill.selected %}selected{% endif %}>{{ skill.name }}</option>{% endfor %}</select></div>
	<div class="hrm-qualification-form__field"><label for="hrm-qualification-experience">{{ lang('experience') }}</label><select id="hrm-qualification-experience" class="hrm-qualification-form__input" name="values[experience_id]"><option value="0">{{ lang('select experience') }}</option>{% for experience in experience_list %}<option value="{{ experience.id }}" {% if experience.selected %}selected{% endif %}>{{ experience.name }}</option>{% endfor %}</select></div>
	<div class="hrm-qualification-form__field hrm-qualification-form__field--full"><label for="hrm-qualification-alternative">{{ lang('alternative') }}</label><select id="hrm-qualification-alternative" class="hrm-qualification-form__input" name="values[alternative_qualification][]" multiple size="{{ alternative_list|length ?: 3 }}">{% for alternative in alternative_list %}<option value="{{ alternative.id }}" {% if alternative.selected %}selected{% endif %}>{{ alternative.name }}</option>{% endfor %}</select></div>
	<div class="hrm-qualification-form__field hrm-qualification-form__field--full"><label for="hrm-qualification-remark">{{ lang('remark') }}</label><textarea id="hrm-qualification-remark" class="hrm-qualification-form__textarea" name="values[remark]">{{ values.remark|default('') }}</textarea></div></div>
	<div class="hrm-qualification-form__actions"><button class="hrm-qualification-form__button" type="submit" name="values[save]" value="1">{{ lang('save') }}</button><button class="hrm-qualification-form__button hrm-qualification-form__button--secondary" type="submit" name="values[apply]" value="1">{{ lang('apply') }}</button><button class="hrm-qualification-form__button hrm-qualification-form__button--secondary" type="submit" name="values[cancel]" value="1">{{ lang('cancel') }}</button></div></form></div>
{% endblock %}