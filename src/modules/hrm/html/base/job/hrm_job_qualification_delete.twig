{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ lang('delete') }} {{ lang('qualification') }}{% endblock %}

{% block content %}
	<div class="hrm-job-delete"><div class="hrm-job-delete__panel"><h1>{{ lang('delete') }} {{ lang('qualification') }}</h1><p>{{ lang('do you really want to delete this entry') }}</p><div class="hrm-job-delete__summary"><div><span class="hrm-job-delete__label">{{ lang('qualification ID') }}:</span> {{ qualification_id }}</div><div><span class="hrm-job-delete__label">{{ lang('name') }}:</span> {{ values.name|default('') }}</div></div><form method="post" action="{{ form_action|e }}"><div class="hrm-job-delete__actions"><button class="hrm-job-delete__button hrm-job-delete__button--danger" type="submit" name="confirm" value="1">{{ lang('yes') }}</button><a class="hrm-job-delete__button hrm-job-delete__button--secondary" href="{{ list_url|e }}">{{ lang('no') }}</a></div></form></div></div>
{% endblock %}

{% block styles %}<style>{{ source('@views/job/hrm_job_task_delete.twig')|split('<style>')[1]|split('</style>')[0]|raw }}</style>{% endblock %}