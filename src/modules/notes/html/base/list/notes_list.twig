{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ lang('notes') }}{% endblock %}

{% block styles %}
	<style>{{ source('@views/list/notes_list.css') }}</style>
{% endblock %}

{% block content %}
{% include '@phpgwapi_components/app_datatable/app_datatable.twig' with {
	id: 'notes-datatable'
} %}
{% endblock %}

{% block scripts %}
<script>
	window.__notesList = {
		id: 'notes-datatable',
		dataUrl: '{{ api_url|e('js') }}',
		addUrl: '{{ add_url|e('js') }}',
		viewUrlTemplate: '{{ view_url_template|replace({'__NOTE_ID__': '{id}'})|e('js') }}',
		editUrlTemplate: '{{ edit_url_template|replace({'__NOTE_ID__': '{id}'})|e('js') }}',
		deleteUrlTemplate: '{{ delete_url_template|replace({'__NOTE_ID__': '{id}'})|e('js') }}',
		categories: {{ categories|json_encode|raw }},
		filters: {{ filters|json_encode|raw }},
		lang: {
			id: '{{ lang('ID')|e('js') }}',
			date: '{{ lang('Date')|e('js') }}',
			content: '{{ lang('content')|e('js') }}',
			owner: '{{ lang('owner')|e('js') }}',
			category: '{{ lang('category')|e('js') }}',
			access: '{{ lang('access')|e('js') }}',
			add: '{{ lang('add note')|e('js') }}',
			view: '{{ lang('view')|e('js') }}',
			edit: '{{ lang('edit')|e('js') }}',
			delete: '{{ lang('delete')|e('js') }}',
			filter: '{{ lang('filter')|e('js') }}',
			resetFilter: '{{ lang('reset filter')|e('js') }}',
			activeFilters: '{{ lang('active filters')|e('js') }}',
			emptyTable: '{{ lang('No data available in table')|e('js') }}',
			search: '{{ lang('Search')|e('js') }}',
			info: '{{ lang('Showing _START_ to _END_ of _TOTAL_ entries')|e('js') }}',
			infoEmpty: '{{ lang('Showing 0 to 0 of 0 entries')|e('js') }}',
			infoFiltered: '{{ lang('(filtered from _MAX_ total entries)')|e('js') }}',
			lengthMenu: '{{ lang('Show _MENU_ entries')|e('js') }}',
			zeroRecords: '{{ lang('No matching records found')|e('js') }}',
			first: '{{ lang('first')|e('js') }}',
			last: '{{ lang('last')|e('js') }}',
			next: '{{ lang('next')|e('js') }}',
			previous: '{{ lang('prev')|e('js') }}'
		}
	};
</script>
<script>{{ source('@views/list/notes_list.js') }}</script>
{% endblock %}
