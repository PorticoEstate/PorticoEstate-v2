{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ qualification_type_id ? lang('edit qualification type') : lang('add qualification type') }}{% endblock %}

{% block styles %}<style>{{ source('@views/job/hrm_job_task_edit.twig')|split('<style>')[1]|split('</style>')[0]|replace({'hrm-task-form': 'hrm-qualification-type-form'})|raw }}</style>{% endblock %}

{% block content %}
	<div class="hrm-qualification-type-form"><div class="hrm-qualification-type-form__header"><h1>{{ qualification_type_id ? lang('edit qualification type') : lang('add qualification type') }}</h1><a href="{{ list_url|e }}">{{ lang('Back to the list') }}</a></div>
	{% if errors %}<div class="hrm-qualification-type-form__notice hrm-qualification-type-form__notice--error">{% for error in errors %}<div>{{ error }}</div>{% endfor %}</div>{% endif %}{% if messages %}<div class="hrm-qualification-type-form__notice hrm-qualification-type-form__notice--message">{% for message in messages %}<div>{{ message }}</div>{% endfor %}</div>{% endif %}
	<form method="post" action="{{ form_action|e }}"><div class="hrm-qualification-type-form__grid">{% if qualification_type_id %}<div class="hrm-qualification-type-form__field"><label>{{ lang('qualification type ID') }}</label><div>{{ qualification_type_id }}</div></div>{% endif %}{% if values.entry_date %}<div class="hrm-qualification-type-form__field"><label>{{ lang('Entry date') }}</label><div>{{ values.entry_date }}</div></div>{% endif %}<div class="hrm-qualification-type-form__field hrm-qualification-type-form__field--full"><label for="hrm-qualification-type-name">{{ lang('name') }}</label><input id="hrm-qualification-type-name" class="hrm-qualification-type-form__input" type="text" name="values[name]" value="{{ values.name|default('') }}" required></div><div class="hrm-qualification-type-form__field hrm-qualification-type-form__field--full"><label for="hrm-qualification-type-descr">{{ lang('descr') }}</label><textarea id="hrm-qualification-type-descr" class="hrm-qualification-type-form__textarea" name="values[descr]">{{ values.descr|default('') }}</textarea></div></div><div class="hrm-qualification-type-form__actions"><button class="hrm-qualification-type-form__button" type="submit" name="values[save]" value="1">{{ lang('save') }}</button><button class="hrm-qualification-type-form__button hrm-qualification-type-form__button--secondary" type="submit" name="values[apply]" value="1">{{ lang('apply') }}</button><button class="hrm-qualification-type-form__button hrm-qualification-type-form__button--secondary" type="submit" name="values[cancel]" value="1">{{ lang('cancel') }}</button></div></form></div>
{% endblock %}