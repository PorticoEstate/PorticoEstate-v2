{% extends layout|default('@views/_bare.twig') %}
{% block title %}{{ lang('Delete') }}{% endblock %}
{% block styles %}
	<style>{{ source('@views/delete/messenger_delete.css') }}</style>
{% endblock %}

{% block content %}
	<div id="messenger-delete-app" class="messenger-message-page" data-api-url="{{ api_url|e }}" data-message-url="{{ message_url|e }}" data-inbox-url="{{ inbox_url|e }}" data-message-id="{{ message_id }}" data-csrf-name="{{ csrf.name|e('html_attr') }}" data-csrf-value="{{ csrf.value|e('html_attr') }}">
		<h1>{{ lang('Delete a message') }}</h1>
		<p>{{ lang('do you really want to delete this entry') }}</p>
		<div id="messenger-delete-error" class="messenger-message messenger-message--error" hidden></div>

		<div class="messenger-form__actions">
			<button id="messenger-delete-confirm" class="messenger-button messenger-button--danger" type="button">{{ lang('Delete') }}</button>
			<a class="messenger-button messenger-button--secondary" href="{{ message_url|e }}">{{ lang('Cancel') }}</a>
		</div>
	</div>
{% endblock %}

{% block scripts %}
	<script>{{ source('@views/delete/messenger_delete.js') }}</script>
{% endblock %}