{% extends layout|default('@views/_bare.twig') %}
{% block title %}{{ lang('Compose global message') }}{% endblock %}
{% block styles %}<style>{{ source('@views/messenger/compose_global/messenger_compose_global.css') }}</style>{% endblock %}
{% block content %}
<div id="messenger-compose-global-app" class="messenger-message-page" data-api-url="{{ api_url|e }}" data-back-url="{{ inbox_url|e }}" data-csrf-name="{{ csrf.name|e('html_attr') }}" data-csrf-value="{{ csrf.value|e('html_attr') }}">
	<h1>{{ lang('Compose global message') }}</h1>
	<div id="messenger-compose-global-error" class="messenger-message messenger-message--error" hidden></div>
	<form id="messenger-compose-global-form" class="messenger-form">
		<label for="messenger-global-subject">{{ lang('Subject') }}</label>
		<input id="messenger-global-subject" name="subject" required>
		<label for="messenger-global-content">{{ lang('Message') }}</label>
		<textarea id="messenger-global-content" name="content" rows="12" required></textarea>
		<div class="messenger-form__actions"><button class="messenger-button" type="submit">{{ lang('Send') }}</button><a class="messenger-button messenger-button--secondary" href="{{ inbox_url|e }}">{{ lang('Cancel') }}</a></div>
	</form>
</div>
{% endblock %}
{% block scripts %}<script>{{ source('@views/messenger/compose_global/messenger_compose_global.js') }}</script>{% endblock %}
