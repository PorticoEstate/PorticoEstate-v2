{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ lang('task') }}{% endblock %}

{% block content %}
	<div class="hrm-job-sublist">
		<a href="{{ list_url|e }}">{{ lang('Back to the list') }}</a>
		<h1>{{ lang('task') }}: {{ job.name|default('') }}</h1>
	</div>
	{% include '@phpgwapi_components/app_datatable/app_datatable.twig' with {
		id: 'hrm-job-task-datatable'
	} %}
{% endblock %}

{% block styles %}
	<style>
		.hrm-job-sublist { margin-bottom: 1rem; }
		.hrm-job-sublist h1 { margin: .5rem 0 0; font-size: 1.5rem; }
	</style>
{% endblock %}

{% block scripts %}
	<script>
		window.__hrmJobTasks = {
			id: 'hrm-job-task-datatable',
			apiUrl: '{{ api_url|e('js') }}',
			newUrl: '{{ new_url|e('js') }}',
			viewUrlTemplate: '{{ view_url_template|replace({'__TASK_ID__': '{id}'})|e('js') }}',
			editUrlTemplate: '{{ edit_url_template|replace({'__TASK_ID__': '{id}'})|e('js') }}',
			deleteUrlTemplate: '{{ delete_url_template|replace({'__TASK_ID__': '{id}'})|e('js') }}',
			moveUpUrlTemplate: '{{ move_up_url_template|replace({'__TASK_ID__': '{id}'})|e('js') }}',
			moveDownUrlTemplate: '{{ move_down_url_template|replace({'__TASK_ID__': '{id}'})|e('js') }}',
			canAdd: {{ can_add ? 'true' : 'false' }},
			canEdit: {{ can_edit ? 'true' : 'false' }},
			canDelete: {{ can_delete ? 'true' : 'false' }},
			pageLength: {{ rows_per_page|default(10) }},
			lengthMenu: {{ length_menu|default([10, 25, 50])|json_encode|raw }},
			lang: {
				name: '{{ lang('name')|e('js') }}',
				descr: '{{ lang('descr')|e('js') }}',
				sorting: '{{ lang('sorting')|e('js') }}',
				add: '{{ lang('add')|e('js') }}',
				view: '{{ lang('view')|e('js') }}',
				edit: '{{ lang('edit')|e('js') }}',
				delete: '{{ lang('delete')|e('js') }}',
				up: '{{ lang('up')|e('js') }}',
				down: '{{ lang('down')|e('js') }}',
				emptyTable: '{{ lang('No data available in table')|e('js') }}',
				search: '{{ lang('search')|e('js') }}'
			}
		};
	</script>
	<script>{{ source('@views/job/hrm_job_task_list.js') }}</script>
{% endblock %}