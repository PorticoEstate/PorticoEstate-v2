{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ lang('Add') }} {{ lang('todo') }}{% endblock %}

{% block styles %}
<style>{{ source('@views/todo/add/todo_add.css') }}</style>
{% endblock %}

{% block content %}
<div id="todo-add-app"
	class="todo-add"
	data-api-url="{{ phpgw_link('/todo/todos') }}"
	data-back-url="{{ phpgw_link('/todo/view/todos') }}"
	data-default-cat-id="{{ selected_cat_id|default(0) }}"
	data-default-parent-id="{{ selected_parent_id|default(0) }}"
	data-lang-save="{{ lang('Save') }}"
	data-lang-saving="{{ lang('common.loading') }}"
	data-lang-error="{{ lang('common.error') }}"
>
	<h2 class="todo-add__title">{{ lang('Add') }} {{ lang('todo') }}</h2>
	<div id="todo-add-error" class="todo-add__error" hidden></div>

	<form id="todo-add-form">
		<div class="todo-add__grid">
			<div class="todo-add__field todo-add__field--full">
				<label for="todo-title">{{ lang('Title') }}</label>
				<input id="todo-title" class="todo-add__input" name="title" type="text" required />
			</div>

			<div class="todo-add__field todo-add__field--full">
				<label for="todo-descr">{{ lang('Description') }}</label>
				<textarea id="todo-descr" class="todo-add__textarea" name="descr"></textarea>
			</div>

			<div class="todo-add__field">
				<label for="todo-cat">{{ lang('Category') }}</label>
				<select id="todo-cat" class="todo-add__select" name="cat">
					{% for category in categories %}
						<option value="{{ category.id }}" {% if category.id == selected_cat_id %}selected{% endif %}>{{ category.name }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-parent">{{ lang('Parent project') }}</label>
				<select id="todo-parent" class="todo-add__select" name="parent">
					{% for todo in parentTodos %}
						<option value="{{ todo.id }}" {% if todo.id == selected_parent_id %}selected{% endif %}>{{ todo.title }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-pri">{{ lang('Urgency') }}</label>
				<select id="todo-pri" class="todo-add__select" name="pri">
					<option value="1">{{ lang('Low') }}</option>
					<option value="2" selected>{{ lang('normal') }}</option>
					<option value="3">{{ lang('high') }}</option>
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-status">{{ lang('Completed') }}</label>
				<select id="todo-status" class="todo-add__select" name="status">
					{% for i in 0..100 %}
						<option value="{{ i }}" {% if i == 0 %}selected{% endif %}>{{ i }}%</option>
					{% endfor %}
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-sdate">{{ lang('Start Date') }}</label>
				<input id="todo-sdate" class="todo-add__input" name="sdate" type="date" />
			</div>

			<div class="todo-add__field">
				<label for="todo-edate">{{ lang('End Date') }}</label>
				<input id="todo-edate" class="todo-add__input" name="edate" type="date" />
			</div>

			<div class="todo-add__field todo-add__field--full">
				<label class="todo-add__checkline"><input id="todo-private" type="checkbox" name="access" /> {{ lang('Private') }}</label>
			</div>

			<div class="todo-add__field">
				<label for="todo-assigned">{{ lang('Assigned to user') }}</label>
				<select id="todo-assigned" class="todo-add__select" name="assigned" multiple size="8">
					{% for user in users %}
						<option value="{{ user.id }}">{{ user.name }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-assigned-group">{{ lang('Assigned to group') }}</label>
				<select id="todo-assigned-group" class="todo-add__select" name="assigned_group" multiple size="8">
					{% for group in groups %}
						<option value="{{ group.id }}">{{ group.name }}</option>
					{% endfor %}
				</select>
			</div>
		</div>

		<div class="todo-add__actions">
			<button id="todo-save" class="todo-add__button" type="submit">{{ lang('Save') }}</button>
			<a class="todo-add__button todo-add__button--secondary" href="{{ phpgw_link('/todo/view/todos') }}">{{ lang('Done') }}</a>
		</div>
	</form>
</div>
{% endblock %}

{% block scripts %}
<script>{{ source('@views/todo/add/todo_add.js') }}</script>
{% endblock %}
