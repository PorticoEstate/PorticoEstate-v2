{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ lang('view qualification') }}{% endblock %}

{% block content %}
	{% set category_name = '' %}{% for category in cat_list %}{% if category.selected %}{% set category_name = category.name %}{% endif %}{% endfor %}{% set skill_name = '' %}{% for skill in skill_list %}{% if skill.selected %}{% set skill_name = skill.name %}{% endif %}{% endfor %}{% set experience_name = '' %}{% for experience in experience_list %}{% if experience.selected %}{% set experience_name = experience.name %}{% endif %}{% endfor %}{% set alternatives = [] %}{% for alternative in alternative_list %}{% if alternative.selected %}{% set alternatives = alternatives|merge([alternative.name]) %}{% endif %}{% endfor %}
	<div class="hrm-job-view"><div class="hrm-job-view__header"><h1>{{ lang('view qualification') }}: {{ job.name|default('') }}</h1><div class="hrm-job-view__links"><a class="hrm-job-view__button hrm-job-view__button--secondary" href="{{ list_url|e }}">{{ lang('Back to the list') }}</a>{% if can_edit %}<a class="hrm-job-view__button" href="{{ edit_url|e }}">{{ lang('edit') }}</a>{% endif %}{% if can_delete %}<a class="hrm-job-view__button hrm-job-view__button--danger" href="{{ delete_url|e }}">{{ lang('delete') }}</a>{% endif %}</div></div><div class="hrm-job-view__panel"><div class="hrm-job-view__field"><div class="hrm-job-view__label">{{ lang('qualification ID') }}</div><div class="hrm-job-view__value">{{ qualification_id }}</div></div>{% if values.entry_date %}<div class="hrm-job-view__field"><div class="hrm-job-view__label">{{ lang('Entry date') }}</div><div class="hrm-job-view__value">{{ values.entry_date }}</div></div>{% endif %}<div class="hrm-job-view__field"><div class="hrm-job-view__label">{{ lang('category') }}</div><div class="hrm-job-view__value">{{ category_name }}</div></div><div class="hrm-job-view__field"><div class="hrm-job-view__label">{{ lang('name') }}</div><div class="hrm-job-view__value">{{ values.name|default('') }}</div></div><div class="hrm-job-view__field hrm-job-view__field--full"><div class="hrm-job-view__label">{{ lang('Descr') }}</div><div class="hrm-job-view__value">{{ values.descr|default('') }}</div></div><div class="hrm-job-view__field hrm-job-view__field--full"><div class="hrm-job-view__label">{{ lang('remark') }}</div><div class="hrm-job-view__value">{{ values.remark|default('') }}</div></div><div class="hrm-job-view__field"><div class="hrm-job-view__label">{{ lang('Skill level') }}</div><div class="hrm-job-view__value">{{ skill_name }}</div></div><div class="hrm-job-view__field"><div class="hrm-job-view__label">{{ lang('experience') }}</div><div class="hrm-job-view__value">{{ experience_name }}</div></div><div class="hrm-job-view__field hrm-job-view__field--full"><div class="hrm-job-view__label">{{ lang('alternative') }}</div><div class="hrm-job-view__value">{{ alternatives|join(', ') }}</div></div></div></div>
{% endblock %}

{% block styles %}<style>{{ source('@views/job/hrm_job_task_view.twig')|split('<style>')[1]|split('</style>')[0]|raw }}</style>{% endblock %}