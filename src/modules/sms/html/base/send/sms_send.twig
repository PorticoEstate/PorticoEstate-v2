{% extends layout|default('@views/_bare.twig') %}
{% block title %}{{ lang('send sms') }}{% endblock %}
{% block styles %}
	<style>{{ source('@views/send/sms_send.css') }}</style>
{% endblock %}

{% block content %}
	<div
		id="sms-send-app"
		class="sms-message-page"
		data-api-url="{{ phpgw_link('/sms/messages')|e }}"
		data-back-url="{{ back_url|e }}"
		data-csrf-name="{{ csrf.name|e('html_attr') }}"
		data-csrf-value="{{ csrf.value|e('html_attr') }}"
		data-max-length="{{ max_length }}"
	>
		<h1>{{ lang('send sms') }}</h1>
		<div id="sms-send-error" class="sms-message sms-message--error" hidden></div>

		<form id="sms-send-form" class="sms-form">
			<label for="sms-from">{{ lang('from') }}</label>
			<input id="sms-from" value="{{ gateway_number }}" disabled>

			<label for="sms-to">{{ lang('to') }}</label>
			<input id="sms-to" name="to" value="{{ p_num }}" placeholder="{{ lang('International format') }}" required>

			<label for="sms-message">{{ lang('message') }}</label>
			<textarea id="sms-message" name="message" rows="6" maxlength="{{ max_length }}" required></textarea>
			<div class="sms-form__counter">{{ lang('character left') }}: <span id="sms-char-count">{{ max_length }}</span></div>

			<label class="sms-form__checkbox">
				<input type="checkbox" id="sms-flash" name="flash"> {{ lang('send as flash message') }}
			</label>
			<label class="sms-form__checkbox">
				<input type="checkbox" id="sms-unicode" name="unicode"> {{ lang('send as unicode') }}
			</label>

			<div class="sms-form__actions">
				<button class="sms-button sms-button--primary" type="submit">{{ lang('save') }}</button>
				<a class="sms-button sms-button--secondary" href="{{ back_url|e }}">{{ lang('cancel') }}</a>
			</div>
		</form>
	</div>
{% endblock %}

{% block scripts %}
	<script>{{ source('@views/send/sms_send.js') }}</script>
{% endblock %}
