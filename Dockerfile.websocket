FROM node:22-alpine AS builder

ARG http_proxy
ARG https_proxy

ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}

WORKDIR /app

# Copy package files and install dependencies
COPY src/WebSocket/node/package.json src/WebSocket/node/package-lock.json* ./
RUN npm install

# Copy source and build
COPY src/WebSocket/node/tsconfig.json src/WebSocket/node/nest-cli.json ./
COPY src/WebSocket/node/src ./src
RUN npx nest build

# --- Production stage ---
FROM node:22-alpine

ARG http_proxy
ARG https_proxy

ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}

WORKDIR /app

# Set timezone to match PHP server behavior
ENV TZ=Europe/Oslo
# Use plain HTTP for the alpine mirror: some corporate proxies do TLS
# interception with a CA that alpine's minimal cert bundle doesn't trust
RUN sed -i 's/https:/http:/' /etc/apk/repositories \
    && apk add --no-cache tzdata

COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./

# The PHP config file is mounted via volume at /var/www/html
# so the config parser can find it at runtime

# The service answers 404 on "/", so that can never pass. The socket.io handshake only answers
# while the service's event loop is running, which is what a stuck service stops doing.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD wget -q -T 4 -O /dev/null "http://localhost:8080/socket.io/?EIO=4&transport=polling" || exit 1

# supervisor.js runs the service (main.js) and restarts it when it stops answering that handshake.
# Set WS_WATCHDOG=off to run main.js directly.
CMD ["node", "/app/dist/supervisor.js"]
