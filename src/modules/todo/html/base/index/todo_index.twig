{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ lang('todo') }}{% endblock %}

{% block styles %}
<style>{{ source('@views/index/todo_index.css') }}</style>
{% endblock %}

{% block content %}
<div id="todo-app"
	class="todo-app"
	data-api-url="{{ phpgw_link('/todo/todos') }}"
	data-csv-url="{{ phpgw_link('/todo/todos/export/csv') }}"
	data-view-url="{{ phpgw_link('/index.php', {'menuaction': 'todo.uitodo.view'}) }}"
	data-add-url="{{ phpgw_link('/todo/view/todos/add') }}"
	data-edit-url="{{ phpgw_link('/index.php', {'menuaction': 'todo.uitodo.edit'}) }}"
	data-delete-url="{{ phpgw_link('/index.php', {'menuaction': 'todo.uitodo.delete'}) }}"
	data-subadd-url="{{ phpgw_link('/index.php', {'menuaction': 'todo.uitodo.add'}) }}"
	data-lang-loading="{{ lang('common.loading') }}"
	data-lang-error="{{ lang('common.error') }}"
	data-lang-empty="{{ lang('No entries') }}"
	data-lang-new="{{ lang('new') }}"
	data-lang-csv="{{ lang('download') }}"
	data-lang-view="{{ lang('View') }}"
	data-lang-edit="{{ lang('Edit') }}"
	data-lang-delete="{{ lang('Delete') }}"
	data-lang-add-sub="{{ lang('Add Sub Project') }}"
	data-lang-search="{{ lang('common.search') }}"
	data-lang-category="{{ lang('Category') }}"
	data-lang-filter="{{ lang('Filter') }}"
	data-lang-all="{{ lang('All') }}"
	data-lang-private="{{ lang('Private') }}"
	data-lang-id="{{ lang('ID') }}"
	data-lang-title="{{ lang('Title') }}"
	data-lang-status="{{ lang('Status') }}"
	data-lang-urgency="{{ lang('Urgency') }}"
	data-lang-start="{{ lang('start date') }}"
	data-lang-end="{{ lang('end date') }}"
	data-lang-owner="{{ lang('created by') }}"
	data-lang-assigned="{{ lang('assigned to') }}"
	data-lang-prev="{{ lang('Previous') }}"
	data-lang-next="{{ lang('Next') }}"
	data-lang-page="{{ lang('Page') }}"
	data-lang-of="{{ lang('of') }}"
	data-lang-showing="{{ lang('Showing') }}"
	data-lang-page-size="{{ lang('Page size') }}"
	data-default-page-size="{{ default_page_size|default(25) }}"
>
	<div class="todo-app__toolbar">
		<select id="todo-cat" class="todo-app__select">
			{% for category in categories %}
				<option value="{{ category.id }}">{{ category.name }}</option>
			{% endfor %}
		</select>

		<input id="todo-search" class="todo-app__search" type="search" placeholder="{{ lang('common.search') }}" />
		<select id="todo-filter" class="todo-app__select">
			<option value="none">{{ lang('All') }}</option>
			<option value="private">{{ lang('Private') }}</option>
		</select>
		<a id="todo-matrix" class="todo-app__button todo-app__button--secondary" href="{{ phpgw_link('/todo/view/todos/matrix', {'month': 'now'|date('m'), 'year': 'now'|date('Y')})|raw }}">{{ lang('view matrix of actual month') }}</a>
		<a id="todo-new" class="todo-app__button" href="{{ phpgw_link('/todo/view/todos/add') }}">{{ lang('new') }}</a>
		<button id="todo-csv" class="todo-app__button todo-app__button--secondary" type="button">{{ lang('download') }}</button>
	</div>

	<div id="todo-loading" class="todo-app__message">{{ lang('common.loading') }}...</div>
	<div id="todo-error" class="todo-app__message todo-app__message--error" hidden></div>

	<table id="todo-table" class="todo-app__table" hidden>
		<thead>
			<tr>
				<th>
					<button type="button" class="todo-app__sort" data-sort-key="id">{{ lang('ID') }}</button>
				</th>
				<th>
					<button type="button" class="todo-app__sort" data-sort-key="title">{{ lang('Title') }}</button>
				</th>
				<th>{{ lang('Status') }}</th>
				<th>
					<button type="button" class="todo-app__sort" data-sort-key="priority">{{ lang('Urgency') }}</button>
				</th>
				<th>
					<button type="button" class="todo-app__sort" data-sort-key="created">{{ lang('start date') }}</button>
				</th>
				<th>
					<button type="button" class="todo-app__sort" data-sort-key="due">{{ lang('end date') }}</button>
				</th>
				<th>{{ lang('created by') }}</th>
				<th>{{ lang('assigned to') }}</th>
				<th>{{ lang('View') }}</th>
				<th>{{ lang('Edit') }}</th>
				<th>{{ lang('Delete') }}</th>
				<th>{{ lang('Add Sub Project') }}</th>
			</tr>
		</thead>
		<tbody id="todo-table-body"></tbody>
	</table>

	<div id="todo-pagination" class="todo-app__pagination" hidden>
		<div id="todo-pagination-summary" class="todo-app__pagination-summary"></div>
		<div class="todo-app__pagination-controls">
			<label class="todo-app__pagination-label" for="todo-page-size">{{ lang('Page size') }}</label>
			<select id="todo-page-size" class="todo-app__select todo-app__select--compact">
				{% for option in page_size_options|default([default_page_size|default(25)]) %}
					<option value="{{ option }}">{{ option }}</option>
				{% endfor %}
			</select>
			<button id="todo-page-prev" class="todo-app__button todo-app__button--secondary" type="button">{{ lang('Previous') }}</button>
			<span id="todo-page-status" class="todo-app__pagination-status"></span>
			<button id="todo-page-next" class="todo-app__button todo-app__button--secondary" type="button">{{ lang('Next') }}</button>
		</div>
	</div>
</div>
{% endblock %}

{% block scripts %}
<script>{{ source('@views/index/todo_index.js') }}</script>
{% endblock %}
