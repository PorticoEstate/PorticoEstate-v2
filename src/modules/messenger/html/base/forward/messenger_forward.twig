{% extends layout|default('@views/_bare.twig') %}
{% block title %}{{ lang('Forward a message') }}{% endblock %}
{% block styles %}
	<style>{{ source('@views/forward/messenger_forward.css') }}</style>
{% endblock %}

{% block content %}
	<div id="messenger-forward-app" class="messenger-message-page" data-api-url="{{ api_url|e }}" data-action-url="{{ action_url|e }}" data-users-url="{{ users_url|e }}" data-back-url="{{ inbox_url|e }}" data-placeholder="{{ lang('Select')|e('html_attr') }}" data-csrf-name="{{ csrf.name|e('html_attr') }}" data-csrf-value="{{ csrf.value|e('html_attr') }}">
		<h1>{{ lang('Forward a message') }}</h1>
		<div id="messenger-forward-error" class="messenger-message messenger-message--error" hidden></div>

		<form id="messenger-forward-form" class="messenger-form">
			<label for="messenger-forward-to">{{ lang('to') }}</label>
			<select id="messenger-forward-to" name="to" required>
				<option value="" selected>{{ lang('Select') }}</option>
			</select>

			<label for="messenger-forward-subject">{{ lang('Subject') }}</label>
			<input id="messenger-forward-subject" name="subject" required>

			<label for="messenger-forward-content">{{ lang('Message') }}</label>
			<textarea id="messenger-forward-content" name="content" rows="12" required></textarea>

			<div class="messenger-form__actions">
				<button class="messenger-button" type="submit">{{ lang('Send') }}</button>
				<a class="messenger-button messenger-button--secondary" href="{{ inbox_url|e }}">{{ lang('Cancel') }}</a>
			</div>
		</form>
	</div>
{% endblock %}

{% block scripts %}
	<script>{{ source('@views/forward/messenger_forward.js') }}</script>
{% endblock %}
