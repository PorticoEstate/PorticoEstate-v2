{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ lang('Edit') }} {{ lang('todo') }}{% endblock %}

{% block styles %}
<style>{{ source('@views/todo/add/todo_add.css') }}</style>
{% endblock %}

{% block content %}
<div id="todo-edit-app"
	class="todo-add"
	data-api-url="{{ phpgw_link('/todo/todos/' ~ todo.id) }}"
	data-back-url="{{ phpgw_link('/todo/view/todos') }}"
	data-date-format="{{ date_format|default('Y-m-d') }}"
	data-lang-save="{{ lang('Save') }}"
	data-lang-saving="{{ lang('common.loading') }}"
	data-lang-error="{{ lang('common.error') }}"
>
	<h2 class="todo-add__title">{{ lang('Edit') }} {{ lang('todo') }}</h2>
	<div id="todo-edit-error" class="todo-add__error" hidden></div>

	<form id="todo-edit-form">
		<div class="todo-add__grid">
			<div class="todo-add__field todo-add__field--full">
				<label for="todo-title">{{ lang('Title') }}</label>
				<input id="todo-title" class="todo-add__input" name="title" type="text" value="{{ todo.title }}" required />
			</div>

			<div class="todo-add__field todo-add__field--full">
				<label for="todo-descr">{{ lang('Description') }}</label>
				<textarea id="todo-descr" class="todo-add__textarea" name="descr">{{ todo.descr }}</textarea>
			</div>

			<div class="todo-add__field">
				<label for="todo-cat">{{ lang('Category') }}</label>
				<select id="todo-cat" class="todo-add__select" name="cat">
					{% for category in categories %}
						<option value="{{ category.id }}" {% if category.id == todo.cat %}selected{% endif %}>{{ category.name }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-parent">{{ lang('Parent project') }}</label>
				<select id="todo-parent" class="todo-add__select" name="parent">
					{% for parentTodo in parentTodos %}
						<option value="{{ parentTodo.id }}" {% if parentTodo.id == todo.parent %}selected{% endif %}>{{ parentTodo.title }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-pri">{{ lang('Urgency') }}</label>
				<select id="todo-pri" class="todo-add__select" name="pri">
					<option value="1" {% if todo.pri == 1 %}selected{% endif %}>{{ lang('Low') }}</option>
					<option value="2" {% if todo.pri == 2 %}selected{% endif %}>{{ lang('normal') }}</option>
					<option value="3" {% if todo.pri == 3 %}selected{% endif %}>{{ lang('high') }}</option>
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-status">{{ lang('Completed') }}</label>
				<select id="todo-status" class="todo-add__select" name="status">
					{% for i in 0..100 %}
						<option value="{{ i }}" {% if i == todo.status %}selected{% endif %}>{{ i }}%</option>
					{% endfor %}
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-sdate">{{ lang('Start Date') }}</label>
				<input id="todo-sdate" class="todo-add__input" name="sdate" type="text" autocomplete="off" placeholder="{{ date_format|default('Y-m-d') }}" title="{{ date_format|default('Y-m-d') }}" value="{{ todo.sdate }}" />
			</div>

			<div class="todo-add__field">
				<label for="todo-edate">{{ lang('End Date') }}</label>
				<input id="todo-edate" class="todo-add__input" name="edate" type="text" autocomplete="off" placeholder="{{ date_format|default('Y-m-d') }}" title="{{ date_format|default('Y-m-d') }}" value="{{ todo.edate }}" />
			</div>

			<div class="todo-add__field todo-add__field--full">
				<label class="todo-add__checkline"><input id="todo-private" type="checkbox" name="access" {% if todo.access_private %}checked{% endif %} /> {{ lang('Private') }}</label>
			</div>

			<div class="todo-add__field">
				<label for="todo-assigned">{{ lang('Assigned to user') }}</label>
				<select id="todo-assigned" class="todo-add__select todo-add__select--multi" name="assigned" multiple size="8" data-placeholder="{{ lang('Select') }} {{ lang('Assigned to user') }}">
					{% for user in users %}
						<option value="{{ user.id }}" {% if user.id in todo.assigned_ids %}selected{% endif %}>{{ user.name }}</option>
					{% endfor %}
				</select>
			</div>

			<div class="todo-add__field">
				<label for="todo-assigned-group">{{ lang('Assigned to group') }}</label>
				<select id="todo-assigned-group" class="todo-add__select todo-add__select--multi" name="assigned_group" multiple size="8" data-placeholder="{{ lang('Select') }} {{ lang('Assigned to group') }}">
					{% for group in groups %}
						<option value="{{ group.id }}" {% if group.id in todo.assigned_group_ids %}selected{% endif %}>{{ group.name }}</option>
					{% endfor %}
				</select>
			</div>
		</div>

		<div class="todo-add__actions">
			<button id="todo-save" class="todo-add__button" type="submit">{{ lang('Save') }}</button>
			<a class="todo-add__button todo-add__button--secondary" href="{{ phpgw_link('/todo/view/todos') }}">{{ lang('Done') }}</a>
		</div>
	</form>
</div>
{% endblock %}

{% block scripts %}
<script>{{ source('@views/todo/edit/todo_edit.js') }}</script>
{% endblock %}
