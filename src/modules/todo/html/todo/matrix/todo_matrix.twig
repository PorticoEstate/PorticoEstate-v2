{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ lang('Matrix') }} {{ lang('todo') }}{% endblock %}

{% block styles %}
<style>{{ source('@views/todo/matrix/todo_matrix.css') }}</style>
{% endblock %}

{% block content %}
<div class="todo-matrix"
	data-status-api-template="{{ phpgw_link('/todo/todos/__TODO_ID__/status') }}"
	data-lang-completed="{{ lang('Completed') }}"
	data-lang-click-to-edit="{{ lang('click to edit') }}"
	data-lang-enter-completed="{{ lang('Enter completed percentage (0-100)') }}"
	data-lang-invalid-status="{{ lang('Status must be a number between 0 and 100') }}"
	data-lang-saving="{{ lang('common.loading') }}"
	data-lang-update-failed="{{ lang('Failed to update status') }}"
>
	<div class="todo-matrix__toolbar">
		<a class="todo-matrix__back" href="{{ phpgw_link('/todo/view/todos') }}">{{ lang('Done') }}</a>
	</div>
	<div class="todo-matrix__content">
		{{ matrix_html|raw }}
	</div>
</div>
{% endblock %}

{% block scripts %}
<script>{{ source('@views/todo/matrix/todo_matrix.js') }}</script>
{% endblock %}
