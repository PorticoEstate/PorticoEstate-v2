{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ lang('E-Mail preferences') }}{% endblock %}

{% block styles %}
<style>{{ source('@views/preferences.css') }}</style>
{% endblock %}

{% block content %}
<main class="email-preferences" id="email-preferences"
	data-api-url="{{ api_url|e('html_attr') }}"
	data-save-url="{{ save_url|e('html_attr') }}"
	data-csrf-name="{{ csrf_name|e('html_attr') }}"
	data-csrf-value="{{ csrf_value|e('html_attr') }}">
	<header class="email-preferences-header">
		<div><p>{{ lang('E-Mail') }}</p><h1>{{ lang('Preferences') }}</h1></div>
		<nav>
			<a href="{{ extra_accounts_url|e }}">{{ lang('Extra email accounts') }}</a>
			<a href="{{ inbox_url|e }}">{{ lang('Back to inbox') }}</a>
		</nav>
	</header>
	<div class="email-preferences-status" id="email-preferences-status" role="status" aria-live="polite">{{ lang('Loading preferences') }}</div>
	<div class="email-preferences-error" id="email-preferences-error" role="alert" hidden></div>
	<form id="email-preferences-form" hidden>
		<section class="email-preferences-section">
			<h2>{{ lang('Standard preferences') }}</h2>
			<div id="email-preferences-standard"></div>
		</section>
		<section class="email-preferences-section">
			<h2>{{ lang('Custom settings') }}</h2>
			<label class="email-preferences-toggle"><input id="email-preferences-custom-enabled" type="checkbox"> {{ lang('Use custom settings') }}</label>
			{% if oauth_url %}<p><a href="{{ oauth_url|e }}">{{ lang('Connect Microsoft Outlook with OAuth2') }}</a></p>{% endif %}
			<div id="email-preferences-custom-fields"></div>
		</section>
		<div class="email-preferences-actions">
			<button type="submit">{{ lang('Save preferences') }}</button>
		</div>
	</form>
</main>
{% endblock %}

{% block scripts %}
<script>{{ source('@views/preferences.js') }}</script>
{% endblock %}
