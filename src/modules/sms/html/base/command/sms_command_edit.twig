{% extends layout|default('@views/_bare.twig') %}

{% block title %}
	{{ command.id|default(0) ? lang('edit command') : lang('add command') }}
{% endblock %}

{% block content %}
	<div
		id="sms-command-edit"
		class="sms-message-page"
		data-api-url="{{ api_url|e }}"
		data-list-url="{{ list_url|e }}"
		data-id="{{ command.id|default(0) }}"
		data-csrf-name="{{ csrf.name|e('html_attr') }}"
		data-csrf-value="{{ csrf.value|e('html_attr') }}"
	>
		<h1>{{ command.id|default(0) ? lang('edit command') : lang('add command') }}</h1>
		<div id="sms-command-error" hidden></div>

		<form id="sms-command-form" class="sms-form">
			<label for="command-code">
				{{ lang('code') }}
				<input id="command-code" value="{{ command.code|default('')|e('html_attr') }}" required>
			</label>

			<label for="command-type">
				{{ lang('command type') }}
				<select id="command-type" required>
					{% for type in types %}
						<option value="{{ type.id }}" {% if type.id == command.type|default('') %}selected{% endif %}>
							{{ type.name }}
						</option>
					{% endfor %}
				</select>
			</label>

			<label for="command-exec">
				{{ lang('SMS command exec') }}
				<input id="command-exec" value="{{ command.exec|default('')|e('html_attr') }}" required>
			</label>

			<label for="command-descr">
				{{ lang('descr') }}
				<textarea id="command-descr">{{ command.descr|default('')|e }}</textarea>
			</label>

			<div class="sms-form__actions">
				<button class="sms-button" type="submit">{{ lang('save') }}</button>
				<a class="sms-button sms-button--secondary" href="{{ list_url|e }}">
					{{ lang('cancel') }}
				</a>
			</div>
		</form>
	</div>
{% endblock %}

{% block scripts %}
	<script>{{ source('@views/command/sms_command_edit.js') }}</script>
{% endblock %}
