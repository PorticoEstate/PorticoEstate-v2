{% extends layout|default('@views/_bare.twig') %}
{% block title %}{{ lang('Read message') }}{% endblock %}
{% block styles %}
	<style>{{ source('@views/view/messenger_view.css') }}</style>
{% endblock %}

{% block content %}
	<div id="messenger-view-app" class="messenger-message-page" data-api-url="{{ api_url|e }}" data-inbox-url="{{ inbox_url|e }}" data-compose-url="{{ compose_url|e }}" data-reply-url="{{ reply_url|e }}" data-forward-url="{{ forward_url|e }}">
		<h1>{{ lang('Read message') }}</h1>
		<div id="messenger-view-error" class="messenger-message messenger-message--error" hidden></div>

		<dl class="messenger-details">
			<dt>{{ lang('From') }}</dt>
			<dd id="messenger-view-from"></dd>
			<dt>{{ lang('Subject') }}</dt>
			<dd id="messenger-view-subject"></dd>
			<dt>{{ lang('Date') }}</dt>
			<dd id="messenger-view-date"></dd>
			<dt>{{ lang('Message') }}</dt>
			<dd id="messenger-view-content"></dd>
		</dl>

		<div class="messenger-form__actions">
			<a class="messenger-button" href="{{ reply_url|e }}">{{ lang('Reply') }}</a>
			<a class="messenger-button" href="{{ forward_url|e }}">{{ lang('Forward') }}</a>
			<a class="messenger-button messenger-button--danger" href="{{ delete_url|e }}">{{ lang('Delete') }}</a>
			<a class="messenger-button messenger-button--secondary" href="{{ inbox_url|e }}">{{ lang('Inbox') }}</a>
			<a class="messenger-button messenger-button--secondary" href="{{ compose_url|e }}">{{ lang('Compose') }}</a>
		</div>
	</div>
{% endblock %}

{% block scripts %}
	<script>{{ source('@views/view/messenger_view.js') }}</script>
{% endblock %}
