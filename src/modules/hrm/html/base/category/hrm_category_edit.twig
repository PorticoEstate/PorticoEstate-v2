{% extends layout|default('@views/_bare.twig') %}

{% block title %}{{ category_id ? lang('edit category') : lang('add category') }}{% endblock %}

{% block styles %}
	<style>
		.hrm-category-form { max-width: 42rem; margin: 0 auto; }
		.hrm-category-form__header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
		.hrm-category-form__header h1 { margin: 0; font-size: 1.5rem; }
		.hrm-category-form__notice { margin: 0 0 1rem; padding: .75rem 1rem; border-radius: 4px; }
		.hrm-category-form__notice--error { border: 1px solid #b00020; background: #fff5f6; color: #7a0015; }
		.hrm-category-form__notice--message { border: 1px solid #2e7d32; background: #f4fbf4; color: #1b5e20; }
		.hrm-category-form__grid { display: grid; gap: 1rem; padding: 1rem; border: 1px solid #d5dde6; border-radius: 6px; background: #fff; }
		.hrm-category-form__field { display: flex; flex-direction: column; gap: .3rem; }
		.hrm-category-form__field label { color: #526579; font-weight: 600; }
		.hrm-category-form__input, .hrm-category-form__textarea { width: 100%; box-sizing: border-box; border: 1px solid #b8c4d1; border-radius: 4px; padding: .45rem .55rem; color: #17324d; background: #fff; }
		.hrm-category-form__textarea { min-height: 7rem; resize: vertical; }
		.hrm-category-form__actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1rem; }
		.hrm-category-form__button { border: 1px solid #24527a; border-radius: 4px; padding: .45rem .85rem; background: #24527a; color: #fff; text-decoration: none; cursor: pointer; }
		.hrm-category-form__button--secondary { background: #fff; color: #24527a; }
	</style>
{% endblock %}

{% block content %}
	<div class="hrm-category-form">
		<div class="hrm-category-form__header">
			<h1>{{ category_id ? lang('edit category') : lang('add category') }}</h1>
			<a href="{{ list_url|e }}">{{ lang('Back to the list') }}</a>
		</div>

		{% if errors %}
			<div class="hrm-category-form__notice hrm-category-form__notice--error">
				{% for error in errors %}<div>{{ error }}</div>{% endfor %}
			</div>
		{% endif %}
		{% if messages %}
			<div class="hrm-category-form__notice hrm-category-form__notice--message">
				{% for message in messages %}<div>{{ message }}</div>{% endfor %}
			</div>
		{% endif %}

		<form method="post" action="{{ form_action|e }}">
			<div class="hrm-category-form__grid">
				<div class="hrm-category-form__field">
					<label for="hrm-category-id">{{ lang('category ID') }}</label>
					<input id="hrm-category-id" class="hrm-category-form__input" type="text" name="values[id]" value="{{ category_id ? category_id : values.id|default('') }}" {% if category_id %}readonly{% endif %} required>
				</div>
				<div class="hrm-category-form__field">
					<label for="hrm-category-descr">{{ lang('Descr') }}</label>
					<textarea id="hrm-category-descr" class="hrm-category-form__textarea" name="values[descr]">{{ values.descr|default('') }}</textarea>
				</div>
			</div>

			<div class="hrm-category-form__actions">
				<button class="hrm-category-form__button" type="submit" name="values[save]" value="1">{{ lang('save') }}</button>
				<button class="hrm-category-form__button hrm-category-form__button--secondary" type="submit" name="values[done]" value="1">{{ lang('done') }}</button>
			</div>
		</form>
	</div>
{% endblock %}