{% extends layout|default('@views/_bare.twig') %}
{% block title %}{{ lang('Reply to a message') }}{% endblock %}
{% block styles %}<style>{{ source('@views/messenger/reply/messenger_reply.css') }}</style>{% endblock %}
{% block content %}<div id="messenger-reply-app" class="messenger-message-page" data-api-url="{{ api_url|e }}" data-action-url="{{ action_url|e }}" data-users-url="{{ users_url|e }}" data-back-url="{{ inbox_url|e }}" data-csrf-name="{{ csrf.name|e('html_attr') }}" data-csrf-value="{{ csrf.value|e('html_attr') }}"><h1>{{ lang('Reply to a message') }}</h1><div id="messenger-reply-error" class="messenger-message messenger-message--error" hidden></div><form id="messenger-reply-form" class="messenger-form"><label for="messenger-reply-to">{{ lang('to') }}</label><select id="messenger-reply-to" name="to" required></select><label for="messenger-reply-subject">{{ lang('Subject') }}</label><input id="messenger-reply-subject" name="subject" required><label for="messenger-reply-content">{{ lang('Message') }}</label><textarea id="messenger-reply-content" name="content" rows="12" required></textarea><div class="messenger-form__actions"><button class="messenger-button" type="submit">{{ lang('Send') }}</button><a class="messenger-button messenger-button--secondary" href="{{ inbox_url|e }}">{{ lang('Cancel') }}</a></div></form></div>{% endblock %}
{% block scripts %}<script>{{ source('@views/messenger/reply/messenger_reply.js') }}</script>{% endblock %}
